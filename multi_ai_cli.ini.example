# ==============================================================================
# Multi-AI CLI Configuration File
# New Agent / Engine Separated Layout
# ==============================================================================

[API_KEYS]
# API keys may also be provided via environment variables.
# Environment variables should override these values when present.
GEMINI_API_KEY = ...
OPENAI_API_KEY = ...
anthropic_api_key = ...
grok_api_key = ...
figma_access_token = ...


# ==============================================================================
# Runtime
# ==============================================================================
#
# Global application/runtime behavior.
# These values are independent of individual Agent definitions.
# ==============================================================================

[RUNTIME]

# Maximum number of conversation turns
# (user + assistant pairs) retained by each Agent instance.
max_history_turns = 30

# Auto-continue behavior for responses that hit an output limit.
auto_continue_max_rounds = 5
auto_continue_tail_chars = 1200


# ==============================================================================
# Agents
# ==============================================================================
#
# Agent names are logical aliases.
#
# The Agent name does NOT imply:
#
#   - Provider
#   - Local / Cloud
#   - Model
#   - Adapter
#
# Required:
#
#   adapter
#   server
#   engine
#
# Optional:
#
#   api_key_ref
#   role
#   max_output_tokens
#
# Currently supported adapter:
#
#   openai-compatible
#
# Example:
#
#   [AGENT.reviewer]
#   adapter = openai-compatible
#   server = https://api.openai.com/v1
#   engine = <model-name>
#   api_key_ref = openai_api_key
#   role = review
#   max_output_tokens = 8192
#
# Agent aliases may contain:
#
#   a-z
#   0-9
#   _
#   -
#
# ==============================================================================


# ------------------------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------------------------

[AGENT.gpt]
adapter = openai-compatible
server = https://api.openai.com/v1
engine = gpt-5.4
api_key_ref = openai_api_key
max_output_tokens = 8192


[AGENT.gpt_code]
adapter = openai-compatible
server = https://api.openai.com/v1
engine = gpt-5.4
api_key_ref = openai_api_key
role = code
max_output_tokens = 8192


[AGENT.gpt_review]
adapter = openai-compatible
server = https://api.openai.com/v1
engine = gpt-4o-mini
api_key_ref = openai_api_key
role = review
max_output_tokens = 8192


[AGENT.gpt_plan]
adapter = openai-compatible
server = https://api.openai.com/v1
engine = gpt-5.4
api_key_ref = openai_api_key
role = plan
max_output_tokens = 8192


[AGENT.gpt_chat]
adapter = openai-compatible
server = https://api.openai.com/v1
engine = gpt-4o-mini
api_key_ref = openai_api_key
role = chat
max_output_tokens = 8192

# ------------------------------------------------------------------------------
# Claude
# ------------------------------------------------------------------------------

[AGENT.claude]
adapter = openai-compatible
server = https://api.anthropic.com/v1
engine = claude-opus-4-6
api_key_ref = anthropic_api_key
max_output_tokens = 8192


# ------------------------------------------------------------------------------
# Gemini
# ------------------------------------------------------------------------------

[AGENT.gemini]
adapter = openai-compatible
server = https://generativelanguage.googleapis.com/v1beta
engine = gemini-3.1-pro-preview
api_key_ref = GEMINI_API_KEY
max_output_tokens = 8192

# ------------------------------------------------------------------------------
# Grok
# ------------------------------------------------------------------------------

[AGENT.grok]
adapter = openai-compatible
server = https://api.x.ai/v1
engine = grok-4-latest
api_key_ref = grok_api_key
max_output_tokens = 8192


[AGENT.grok_chat]
adapter = openai-compatible
server = https://api.x.ai/v1
engine = grok-4-latest
api_key_ref = grok_api_key
role = chat
max_output_tokens = 8192


# ------------------------------------------------------------------------------
# Local LLM
# ------------------------------------------------------------------------------
#
# Ollama / LM Studio / vLLM or another OpenAI-compatible local endpoint.
#
# api_key_ref is intentionally omitted because this endpoint does not require
# authentication.
# ------------------------------------------------------------------------------

[AGENT.local]
adapter = openai-compatible
server = http://192.168.11.24:11434/v1
engine = qwen2.5:3b
max_output_tokens = 8192


[AGENT.local_code]
adapter = openai-compatible
server = http://192.168.11.24:11434/v1
engine = qwen2.5:3b
role = code
max_output_tokens = 8192


[AGENT.local_test]
adapter = openai-compatible
server = http://192.168.11.24:11434/v1
engine = qwen2.5:3b
role = test
max_output_tokens = 8192


[AGENT.local_chat]
adapter = openai-compatible
server = http://192.168.11.24:11434/v1
engine = qwen2.5:3b
role = chat
max_output_tokens = 8192


# ==============================================================================
# Gemini / Claude
# ==============================================================================
#
# The current new Agent configuration supports only:
#
#   adapter = openai-compatible
#
# Therefore native Gemini and Anthropic endpoints are not defined here.
#
# They can be added later when:
#
#   adapter = gemini
#   adapter = anthropic
#
# are supported, or when an OpenAI-compatible gateway is used.
#
# Example through an OpenAI-compatible gateway:
#
# [AGENT.gemini]
# adapter = openai-compatible
# server = http://<gateway>/v1
# engine = gemini-3.1-pro-preview
# api_key_ref = gemini_api_key
# max_output_tokens = 8192
#
# [AGENT.claude]
# adapter = openai-compatible
# server = http://<gateway>/v1
# engine = claude-opus-4-6
# api_key_ref = anthropic_api_key
# max_output_tokens = 8192


# ==============================================================================
# Application Paths
# ==============================================================================

[Paths]

# Folder for prompt/persona assets used by commands such as @efficient.
work_efficient = prompts

# Blackboard directory for read/write artifacts (-r / -w).
work_data = work_data


# ==============================================================================
# Logging
# ==============================================================================

[logging]

enabled = true
log_dir = logs
base_filename = chat.log
max_bytes = 10485760
backup_count = 5
log_level = INFO


# ==============================================================================
# Figma Integration
# ==============================================================================

[FIGMA]

handoff_dir = work_data/figma_handoff


# ==============================================================================
# GitHub Read-only Integration
# ==============================================================================
#
# Used by @github.* commands.
#
# Environment variables override these values:
#
#   GITHUB_TOKEN
#   GITHUB_API_BASE_URL
#
# For organization/private repositories, ensure that the token Resource owner
# and repository permissions are configured correctly.
# ==============================================================================

[GITHUB]

token =
api_base_url = https://api.github.com